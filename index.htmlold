    </svg>

    <!-- APP CONTAINER -->
    <main id="app-root">
    <!-- GLOBAL HEADER -->
    <header id="main-header" class="app-header">
        <div class="header-left">
            <a href="/" id="logo-home" class="view-setup-only" aria-label="Close session"><img class="home-logo-img" src="/images/kafichr-logo-circle-alpha-256.png" alt="Kafić.hr"></a>
            <input type="text" id="header-username" class="editable-label view-setup-only" placeholder="Your Name" aria-label="Username" data-i18n="setup.label_name">
            
            <button id="waiter-exit-btn" class="icon-btn view-waiter-only" aria-label="Exit"><svg class="ic" aria-hidden="true"><use href="#ic-times"></use></svg></button>
            <div class="header-titles view-waiter-only">
                <div class="breadcrumbs" id="waiter-breadcrumbs">Tables</div>
            </div>

            <button id="bartender-back-btn" class="icon-btn view-bartender-only" aria-label="Back"><svg class="ic" aria-hidden="true"><use href="#ic-chevron-left"></use></svg></button>
            <span class="header-title-text view-bartender-only" data-i18n="bartender.incoming">Incoming Orders</span>

            <button id="manager-back-btn" class="icon-btn view-manager-only" aria-label="Back"><svg class="ic" aria-hidden="true"><use href="#ic-chevron-left"></use></svg></button>
            <span class="header-title-text view-manager-only" data-i18n="settings.title">Settings</span>
        </div>
        <div class="header-right">
            <div class="net-indicator view-waiter-only" id="waiter-net-pill" aria-live="polite">
                <span class="dot"></span>
                <span class="label"></span>
            </div>

            <button id="header-conn" class="header-conn-indicator view-setup-only view-bartender-only view-manager-only" aria-label="Connection Status">
                <span class="dot"></span>
                <span class="count"></span>
            </button>
            
            <div id="header-tools-drawer" class="header-tools-drawer collapsed">
                <button id="btn-open-help" class="icon-btn small view-setup-only" aria-label="Open guide" title="Open guide">
                    <svg class="ic" aria-hidden="true"><use href="#ic-info"></use></svg>
                </button>
                <button id="btn-toggle-theme" class="icon-btn small not-waiter" aria-label="Toggle Theme">◐</button>
                <button id="btn-toggle-lang" class="icon-btn small view-setup-only" aria-label="Toggle Language"></button>
            </div>
            <button id="btn-toggle-tools" class="icon-btn small header-tools-toggle" aria-label="More options">
                <svg class="ic" aria-hidden="true"><use href="#ic-chevron-left"></use></svg>
            </button>
        </div>
    </header>

    <div id="views-container">
        <!-- VIEW 1: SETUP (Home, Join, Lobby) -->
        <section id="view-setup" class="view active">
            <!-- Global Top Bar for Setup -->
            

            <!-- Slide 1: Welcome (Redesigned) -->
            <div id="setup-home" class="setup-slide active">
                <div class="home-layout">
                    <div class="hero-section">
                        <img src="/images/kafichr-logo-alpha-512.png" class="hero-logo" alt="Logo">
                        <h1 class="hero-title" data-i18n="app.tagline">Sync Your Bar</h1>
                        <p class="hero-subtitle" data-i18n="app.subline">Instant order management.</p>
                    </div>

                    <div id="resume-dock" class="resume-card hidden">
                        <div class="resume-content">
                            <span class="dot-pulse"></span>
                            <div class="resume-text">
                                <span class="label" data-i18n="setup.resume">Resume Session</span>
                                <code id="resume-code-display" class="code">----</code>
                            </div>
                        </div>
                        <button id="btn-resume" class="btn-resume-arrow" aria-label="Resume">
                            <svg class="ic" aria-hidden="true"><use href="#ic-arrow-right"></use></svg>
                        </button>
                    </div>

                    <div class="home-actions">
                        <button id="btn-host" class="action-card primary">
                            <div class="icon-circle"><svg class="ic" aria-hidden="true"><use href="#ic-plus"></use></svg></div>
                            <div class="card-text">
                                <span class="card-title" data-i18n="setup.host">Host Session</span>
                                <span class="card-desc" data-i18n="setup.lobby">Start a new team</span>
                            </div>
                        </button>
                        
                        <button id="btn-join" class="action-card secondary">
                            <div class="icon-circle"><svg class="ic" aria-hidden="true"><use href="#ic-qrcode"></use></svg></div>
                            <div class="card-text">
                                <span class="card-title" data-i18n="setup.join">Join Session</span>
                                <span class="card-desc" data-i18n="setup.join_title">Connect to existing</span>
                            </div>
                        </button>
                    </div>

                    <div class="home-footer-actions">
                        <button id="btn-install-app" class="pill action hidden">
                            <svg class="ic" aria-hidden="true"><use href="#ic-download"></use></svg> <span data-i18n="actions.install">Install App</span>
                        </button>
                        <button id="btn-reset-app" class="text-link-danger">
                            <svg class="ic" aria-hidden="true"><use href="#ic-trash"></use></svg> <span data-i18n="settings.reset">Reset App</span>
                        </button>
                    </div>
                </div>
                
                <!-- Hidden Welcome Note -->
                <div id="welcome-note" class="hidden"></div>
            </div>

            <!-- Slide 2: Join Input -->
            <div id="setup-join" class="setup-slide">
                <div class="slide-header">
                    <button class="nav-back-btn" aria-label="Back">←</button>
                    <h2 data-i18n="setup.join_title">Enter Code</h2>
                </div>
                <div class="center-content">
                    <p class="helper-text" id="join-hint" aria-live="polite" data-i18n="setup.join_hint">Enter the 6-letter code from the host.</p>
                    <div class="code-input-group">
                        <input type="text" id="join-code-input" placeholder="______" inputmode="latin-prose" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-describedby="join-hint">
                        <div class="input-tools">
                            <button id="btn-scan" aria-label="Scan QR">📷</button>
                            <button id="btn-paste" aria-label="Paste">📋</button>
                        </div>
                    </div>
                    
                    <div class="sync-control-group mt-4">
                        <div class="sync-label-row">
                            <svg class="ic" aria-hidden="true"><use href="#ic-exchange-alt"></use></svg>
                            <span data-i18n="setup.sync_mode">Sync Mode</span>
                            <button class="info-tooltip-btn" data-help="sync" aria-label="Help">
                                <svg class="ic" aria-hidden="true"><use href="#ic-question-circle"></use></svg>
                            </button>
                        </div>
                        <div class="tri-toggle-wrapper">
                            <div class="tri-toggle" id="sync-toggle-join">
                                <button data-val="nosync" data-i18n="setup.sync_none">None</button>
                                <button data-val="slave" data-i18n="setup.sync_slave">Receive</button>
                                <button data-val="host" data-i18n="setup.sync_host">Send</button>
                                <div class="tri-toggle-glider"></div>
                            </div>
                            <div class="sync-status hidden" id="sync-status-join">
                                <svg class="ic spin" aria-hidden="true"><use href="#ic-sync"></use></svg> <span data-i18n="setup.syncing">Syncing...</span>
                            </div>
                        </div>
                    </div>

                    <button id="btn-confirm-join" class="btn-primary full-width large mt-4" data-i18n="actions.connect" disabled>Connect</button>
                </div>
            </div>

            <!-- Slide 3: Lobby -->
            <div id="setup-lobby" class="setup-slide">
                <div class="lobby-card">
                    <div class="qr-box">
                        <canvas id="qr-canvas"></canvas>
                    </div>

                    <div class="sync-control-group compact mb-3">
                        <div class="sync-label-row">
                            <svg class="ic" aria-hidden="true"><use href="#ic-exchange-alt"></use></svg>
                            <span data-i18n="setup.sync_mode">Sync Mode</span>
                            <button class="info-tooltip-btn" data-help="sync" aria-label="Help">
                                <svg class="ic" aria-hidden="true"><use href="#ic-question-circle"></use></svg>
                            </button>
                        </div>
                        <div class="tri-toggle-wrapper">
                            <div class="tri-toggle" id="sync-toggle-lobby">
                                <button data-val="nosync" data-i18n="setup.sync_none">None</button>
                                <button data-val="slave" data-i18n="setup.sync_slave">Receive</button>
                                <button data-val="host" data-i18n="setup.sync_host">Send</button>
                                <div class="tri-toggle-glider"></div>
                            </div>
                             <div class="sync-status hidden" id="sync-status-lobby">
                                <svg class="ic spin" aria-hidden="true"><use href="#ic-sync"></use></svg> <span data-i18n="setup.syncing">Syncing...</span>
                            </div>
                        </div>
                    </div>

                    <div class="session-info">
                        <div class="session-code-row">
                            <div class="session-code" id="display-code">------</div>
                            <button id="btn-copy-link" class="copy-link-btn" aria-label="Copy invite link">
                                <span class="icon">⧉</span>
                                <span class="text" data-i18n="actions.copy_link">Copy Link</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="role-selector">
                    <div class="role-cards dashboard-actions">
                        <button class="role-card" data-role="waiter">
                            <div class="icon">☕</div>
                            <div class="text" data-i18n="roles.waiter">Waiter</div>
                        </button>
                        <button class="role-card" data-role="bartender">
                            <div class="icon">🍸</div>
                            <div class="text" data-i18n="roles.bartender">Bartender</div>
                        </button>
                        <button id="btn-manage" class="role-card settings-card" aria-label="Settings">
                            <div class="icon">⚙</div>
                            <div class="text" data-i18n="settings.title">Settings</div>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- VIEW 2: WAITER -->
        <section id="view-waiter" class="view">
            

            <div id="waiter-grid" class="grid-layout">
                <!-- Dynamic Items -->
            </div>

            <!-- Bottom Drawer for Order -->
            <div id="order-dock" class="order-dock">
                <button id="waiter-back-btn" class="waiter-back-fab hidden" aria-label="Back">
                    <svg class="ic" aria-hidden="true"><use href="#ic-arrow-left"></use></svg>
                    <span class="label" data-i18n="actions.back">Back</span>
                </button>
                <div class="dock-handle"></div>
                <div class="dock-summary">
                    <div class="dock-title">
                        <span id="order-count-badge" class="badge hidden">0</span>
                        <span data-i18n="waiter.current_order">Current Order</span>
                    </div>
                    <div class="dock-tools">
                        <button id="btn-nav-tables" class="dock-icon-btn">
                            <svg class="ic" aria-hidden="true"><use href="#ic-table"></use></svg>
                            <span class="visually-hidden" data-i18n="waiter.tables">Tables</span>
                        </button>
                        <button id="btn-clear-order" class="dock-icon-btn danger">
                            <svg class="ic" aria-hidden="true"><use href="#ic-trash"></use></svg>
                            <span class="visually-hidden" data-i18n="actions.clear">Clear</span>
                        </button>
                    </div>
                </div>
                
                <!-- Outbound order delivery status (Phase 2) -->
                <div id="pending-strip" class="pending-strip hidden"></div>

                <!-- Payment Selector (Moved Here) -->
                <div class="payment-selector compact-payment">
                    <div class="payment-options">
                        <button class="pay-btn" data-method="cash" title="Cash">
                            <svg class="ic" aria-hidden="true"><use href="#ic-money-bill-alt"></use></svg>
                        </button>
                        <button class="pay-btn" data-method="card" title="Card">
                            <svg class="ic" aria-hidden="true"><use href="#ic-credit-card"></use></svg>
                        </button>
                        <button class="pay-btn" data-method="virman" title="Transfer">
                            <svg class="ic" aria-hidden="true"><use href="#ic-file-invoice"></use></svg>
                        </button>
                        <button class="pay-btn" data-method="house" title="On House">
                            <svg class="ic" aria-hidden="true"><use href="#ic-gift"></use></svg>
                        </button>
                    </div>
                </div>

                <div id="order-list" class="order-list-container">
                    <div class="empty-msg" data-i18n="waiter.empty">No items</div>
                </div>
                <div class="dock-actions">
                    <button id="btn-send-order" class="btn-primary full-width large" disabled data-i18n="actions.send">Send Order</button>
                </div>
            </div>
        </section>

        <!-- QUANTITY SHEET (Overlay) -->
        <dialog id="qty-modal" class="bottom-sheet">
             <div class="sheet-content">
                <div class="sheet-header">
                    <div class="sheet-title">
                        <h3 id="qty-item-title">Item</h3>
                        <button id="qty-item-image-btn" class="icon-btn small hidden"><svg class="ic" aria-hidden="true"><use href="#ic-image"></use></svg></button>
                        <div id="qty-item-path" class="pill ghost small hidden"></div>
                    </div>
                    <button id="btn-close-qty" class="icon-btn"> <svg class="ic" aria-hidden="true"><use href="#ic-arrow-left"></use></svg></button>
                </div>
                <div class="qty-body">
                    <div class="qty-sidebar">
                        <button class="qty-step" data-step="1" aria-label="Increase">+</button>
                        <div class="qty-value" id="qty-value">1</div>
                        <button class="qty-step" data-step="-1" aria-label="Decrease">−</button>
                    </div>
                    
                    <div class="qty-main">
                        <div class="qty-grid" id="qty-grid-container">
                            <!-- Buttons injected via JS -->
                        </div>
                        
                        <div class="qty-footer">
                            <button id="btn-clear-qty" class="text-btn danger" data-i18n="actions.clear">Clear</button>
                            <button id="btn-apply-qty" class="btn-primary full-width large" data-i18n="actions.add">Add to order</button>
                        </div>
                    </div>
                </div>
                <div id="qty-image-preview" class="qty-image-preview hidden">
                    <img id="qty-image-preview-img" alt="">
                </div>
             </div>
        </dialog>

        <!-- VIEW 3: BARTENDER -->
        <section id="view-bartender" class="view">
            

            <div id="bartender-feed" class="feed-layout">
                <div class="empty-state">
                    <div class="icon">✓</div>
                    <p data-i18n="bartender.all_done">All caught up</p>
                </div>
            </div>
        </section>

        <!-- VIEW 4: MANAGER -->
        <section id="view-manager" class="view">
            <!-- Content injected by manager.js -->
        </section>

    </div>

    </main>

    <!-- Scanner Overlay -->
    <div id="scan-overlay" class="overlay hidden">
        <button id="btn-close-scan" class="fab-close">✕</button>
        <video id="scan-video" autoplay playsinline></video>
        <div class="scan-reticle"></div>
    </div>

    <!-- Privacy Policy Modal -->
    <dialog id="privacy-modal" class="privacy-modal">
        <div class="privacy-modal-content">
            <header class="privacy-modal-header">
                <h3 data-i18n="footer.privpolicy">Privacy policy</h3>
                <button id="btn-close-privacy" class="icon-btn" type="button" aria-label="Close">✕</button>
            </header>
            <iframe
                id="privacy-modal-frame"
                class="privacy-modal-frame"
                src="privacy-policy.html"
                title="Privacy policy"
                loading="lazy"
            ></iframe>
        </div>
    </dialog>

    <!-- Help Guide Modal -->
    <dialog id="help-modal" class="privacy-modal help-modal">
        <div class="privacy-modal-content">
            <header class="privacy-modal-header">
                <h3 id="help-modal-title" data-i18n="help.title">How to use Kafić.hr</h3>
                <button id="btn-close-help" class="icon-btn" type="button" aria-label="Close">✕</button>
            </header>
            <div id="help-modal-content" class="help-modal-body"></div>
        </div>
    </dialog>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <!-- Swipe Arrows -->
    <div id="arrow-left" class="swipe-arrow left"><svg class="ic" aria-hidden="true"><use href="#ic-chevron-left"></use></svg></div>
    <div id="arrow-right" class="swipe-arrow right"><svg class="ic" aria-hidden="true"><use href="#ic-chevron-right"></use></svg></div>

    <footer class="app-footer" id="app-footer" aria-label="App footer">
        <div class="footer-text">
        </div>
        <div class="footer-links">
            <a class="footer-link" href="https://aningfilm.hr" target="_blank" rel="noopener noreferrer" aria-label="AningFilm">
                <span data-i18n="footer.credit">AF</span>&nbsp; 2026
            </a>
            <span class="dot">•</span>
            <a class="footer-link" href="https://github.com/matijarma/kafic.hr" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                <svg class="ic" aria-hidden="true"><use href="#ic-github"></use></svg>
            </a>
            <span id="version-pill" class="footer-version"></span>
            <span class="dot">•</span>
            <button id="btn-privacy-policy" class="footer-policy-link" type="button">
                <span data-i18n="footer.privpolicy">Privacy policy</span>
            </button>
        </div>
    </footer>

    <!-- Sync Loading Overlay -->
    <div id="sync-loading" class="overlay hidden">
        <div class="loading-column">
            <div class="spinner"></div>
            <p id="sync-loading-text" class="sync-loading-text">Synchronizing data...</p>
            <div id="sync-log" class="sync-log"></div>
        </div>
    </div>

    <script type="module">
        import 'app';
    </script>
</body>
</html>
